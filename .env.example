# Copia este archivo a ".env" y completa los valores.
# ".env" NUNCA se sube a GitHub (esta en .gitignore) porque contiene secretos.

# Base de datos.
# Desarrollo local (SQLite, no requiere instalar nada):
DATABASE_URL="file:./dev.db"
# Produccion / nube (Postgres en Neon, Supabase, etc.) - ejemplo:
# DATABASE_URL="postgresql://usuario:password@host/nombre_bd?sslmode=require"

# Clave secreta para firmar los tokens de sesion (JWT).
# Generar una propia larga y aleatoria antes de ir a produccion.
JWT_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# Puerto donde corre el servidor.
PORT=3000
